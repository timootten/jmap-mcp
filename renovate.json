{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "1 day",
  "rangeStrategy": "pin",
  "reviewers": ["timootten"],
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "description": "Automerge minor and patch updates once CI is green",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "MCP SDK: own group, always reviewed by hand",
      "matchPackageNames": ["/^@modelcontextprotocol//"],
      "groupName": "MCP SDK",
      "automerge": false
    },
    {
      "description": "engines is a compatibility range for users, never pin it",
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "description": "Node only runs npm publish in the release workflow; stay on the LTS line until a human moves it",
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
