{
  "name": "@timootten/jmap-mcp",
  "version": "0.1.2",
  "private": false,
  "description": "Small, auditable MCP server for one JMAP mail account (RFC 8620/8621)",
  "keywords": [
    "bun",
    "email",
    "jmap",
    "mcp",
    "stalwart"
  ],
  "homepage": "https://github.com/timootten/jmap-mcp#readme",
  "bugs": {
    "url": "https://github.com/timootten/jmap-mcp/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timootten/jmap-mcp.git"
  },
  "bin": {
    "jmap-mcp": "src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt",
    "check": "bun run typecheck && bun run lint",
    "test": "bun test",
    "smoke": "bun scripts/smoke-pack.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "htmlparser2": "12.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
