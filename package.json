{
  "name": "@timootten/jmap-mcp",
  "version": "0.1.0",
  "description": "Small, auditable MCP server for one JMAP mail account (RFC 8620/8621)",
  "type": "module",
  "license": "MIT",
  "private": false,
  "bin": {
    "jmap-mcp": "src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timootten/jmap-mcp.git"
  },
  "scripts": {
